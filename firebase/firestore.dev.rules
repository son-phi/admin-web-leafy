// DEV / EMULATOR ONLY. Original Android rules were not available.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && request.auth.token.admin == true; }
  match /plants/{id} { allow read: if signedIn(); allow write: if false; }
  match /diseases/{id} { allow read: if signedIn(); allow write: if false; }
  match /admin_audit/{id} { allow read: if admin(); allow write: if false; }
  match /users/{uid} { allow read: if admin() || (signedIn() && request.auth.uid == uid); allow write: if false; }
  match /gardens/{id} { allow read: if admin(); allow write: if false; }
 }
}
