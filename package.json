{
  "name": "leafy-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode mock --host 127.0.0.1",
    "dev:firebase": "vite --mode development --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --mode mock",
    "build:dev": "tsc --noEmit && vite build --mode development",
    "build:production": "tsc --noEmit && vite build --mode production",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "dev:emulator": "vite --mode emulator --host 127.0.0.1",
    "build:emulator": "tsc --noEmit && vite build --mode emulator",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-leafy-admin",
    "seed:emulator": "node functions/scripts/seed-emulator.mjs",
    "test:emulator": "npm --prefix functions run build && firebase emulators:exec --project demo-leafy-admin --only auth,firestore,functions,database,storage \"vitest run --config vitest.emulator.config.ts\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.3.0",
    "firebase": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.8.0",
    "recharts": "~3.10.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@firebase/rules-unit-testing": "~5.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.34.0",
    "firebase-tools": "^15.37.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
